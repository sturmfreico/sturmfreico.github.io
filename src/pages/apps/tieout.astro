---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Tieout - Verify Generated Reports With Confidence',
  description:
    'Compare generated reports against your original data sources to catch hallucinations, verify accuracy, and ensure complete data integrity.',
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: 'https://tieout.ai',
        target: '_blank',
        icon: 'tabler:arrow-right',
      },
      {
        text: 'Learn More',
        href: 'https://tieout.ai',
        target: '_blank',
      },
    ]}
  >
    <Fragment slot="title"> Tieout </Fragment>
    <Fragment slot="subtitle">
      Compare generated reports against your original data sources to catch hallucinations, verify accuracy, and ensure
      complete data integrity.
    </Fragment>
  </Hero>

  <Stats
    title="Trusted by Teams Worldwide"
    stats={[
      { title: 'Accuracy Rate', amount: '99.7%' },
      { title: 'Reports Verified', amount: '2K+' },
      { title: 'Avg. Time Saved', amount: '8hrs' },
    ]}
  />

  <Features
    id="features"
    tagline="Features"
    title="Everything You Need to Trust AI Outputs"
    subtitle="Comprehensive verification tools to validate generated content against your source documents."
    items={[
      {
        title: 'Multi-Format Support',
        description: 'Upload and parse CSV, PDF, Excel, and other document formats as your source of truth.',
        icon: 'tabler:file-upload',
      },
      {
        title: 'Smart Comparison',
        description: 'Automatically extract and compare numbers, percentages, and data points between reports.',
        icon: 'tabler:arrows-diff',
      },
      {
        title: 'Hallucination Detection',
        description: 'Identify fabricated data, incorrect statistics, and made-up citations in AI outputs.',
        icon: 'tabler:eye-check',
      },
      {
        title: 'Link Verification',
        description: 'Validate URLs and references mentioned in generated reports against actual sources.',
        icon: 'tabler:link',
      },
      {
        title: 'Detailed Reports',
        description: 'Generate comprehensive accuracy reports with discrepancy highlights and confidence scores.',
        icon: 'tabler:report-analytics',
      },
      {
        title: 'Audit Trail',
        description: 'Keep a complete history of all verifications for compliance and accountability.',
        icon: 'tabler:history',
      },
    ]}
  />

  <Steps
    title="Verify Reports in Three Simple Steps"
    subtitle="Upload your AI-generated report, add your source documents, and let Tieout do the heavy lifting. Get detailed accuracy reports in seconds."
    items={[
      {
        title: 'Upload Report & Source Data',
        description: 'Upload CSV, PDF, Excel, and other document formats as your original data source.',
        icon: 'tabler:upload',
      },
      {
        title: 'Compare Data',
        description:
          'Tieout automatically extracts and compares data points, numbers, and references between your source and generated report.',
        icon: 'tabler:analyze',
      },
      {
        title: 'Review Results',
        description:
          'Get a detailed accuracy report highlighting discrepancies, hallucinated data, and confidence scores.',
        icon: 'tabler:checklist',
      },
    ]}
  />

  <CallToAction
    title="Stop Guessing. Start Verifying."
    subtitle="Join teams who trust their AI outputs because they verify them with Tieout."
    actions={[
      {
        variant: 'primary',
        text: 'Get Started on Tieout',
        href: 'https://tieout.ai',
        target: '_blank',
        icon: 'tabler:arrow-right',
      },
    ]}
  />
</Layout>
